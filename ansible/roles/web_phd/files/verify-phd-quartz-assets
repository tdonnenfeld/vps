#!/usr/bin/env bash
set -euo pipefail
cd /opt/phd-hub
container="$(docker compose --env-file .env -f infrastructure/compose.yml -f infrastructure/compose.override.yml ps -q phd-web)"
test -n "$container" || { echo "phd-web is not running" >&2; exit 1; }

# Check the actual Next.js -> nginx/Quartz proxy, without sending private
# documents or application credentials to CI logs.
docker exec -i "$container" node - <<'NODE'
const assert = require("node:assert/strict");
const origin = "http://127.0.0.1:3000";
const headers = {"Remote-User":process.env.ALLOWED_USER || ""};

function htmlAttributes(tag){
  const attrs={};
  for(const match of tag.matchAll(/([:\\w-]+)\\s*=\\s*(["'])(.*?)\\2/g))attrs[match[1].toLowerCase()]=match[3];
  return attrs;
}
async function verifyEmittedAssets(page){
  const response=await fetch(origin+page,{headers,redirect:"manual",signal:AbortSignal.timeout(10000)});
  assert.equal(response.status,200,"Quartz page must return HTTP 200");
  assert((response.headers.get("content-type")||"").includes("text/html"),"Quartz page must be HTML");
  const html=await response.text();
  assert(!/Knowledge base not (published|built) yet/i.test(html),"Quartz setup placeholder is not a completed build");
  const assets=[];
  for(const match of html.matchAll(/<(link|script)\\b[^>]*>/gi)){
    const attrs=htmlAttributes(match[0]);
    const tag=match[1].toLowerCase();
    if(tag==="link"&&/\\bstylesheet\\b/i.test(attrs.rel||"")&&attrs.href)assets.push({url:attrs.href,type:"text/css"});
    if(tag==="script"&&attrs.src)assets.push({url:attrs.src,type:"javascript"});
  }
  let css=0,js=0;
  for(const asset of assets){
    const url=new URL(asset.url,origin+page);
    if(url.origin!==origin)continue;
    assert(url.pathname.startsWith("/knowledge/"),"Quartz asset URL escapes /knowledge prefix");
    const res=await fetch(url,{headers,redirect:"manual",signal:AbortSignal.timeout(10000)});
    assert.equal(res.status,200,"Quartz-emitted asset must load without redirects");
    assert((res.headers.get("content-type")||"").includes(asset.type),"Quartz-emitted asset has wrong MIME type");
    assert((await res.text()).trim().length>0,"Quartz-emitted asset is empty");
    if(asset.type==="text/css")css++;else js++;
  }
  assert(css>0,"Quartz HTML must reference a working local stylesheet");
  assert(js>0,"Quartz HTML must reference a working local script");
  console.log("PASS: Quartz HTML references working CSS and JS through the /knowledge proxy");
}

(async()=>{
  // Docker recreation completes before Next.js is always accepting traffic.
  let ready=false;
  for(let attempt=0;attempt<30;attempt++){
    try{
      const response=await fetch(origin+"/knowledge/index.html",{headers,signal:AbortSignal.timeout(4000)});
      if(response.status===200){ready=true;break;}
    }catch{}
    await new Promise(resolve=>setTimeout(resolve,2000));
  }
  assert(ready,"phd-web/Quartz proxy was not ready after 60 seconds");

  const entry = await fetch(origin+"/knowledge",{headers,redirect:"manual"});
  assert.equal(entry.status,307,"/knowledge must redirect to the folder-aware URL");
  assert.equal(entry.headers.get("location"),"/knowledge/index.html");
  console.log("PASS: Knowledge entry redirects to /knowledge/index.html");

  const vault=await fetch(origin+"/knowledge/PhD/",{headers,redirect:"manual"});
  assert.equal(vault.status,200,"/knowledge/PhD/ must serve the vault folder without stripping its slash");
  assert((vault.headers.get("content-type")??"").includes("text/html"));
  console.log("PASS: /knowledge/PhD/ serves the vault folder without redirects");

  const noSlash=await fetch(origin+"/knowledge/PhD",{headers,redirect:"manual"});
  assert.equal(noSlash.status,200,"A folder URL without its slash must serve index.html without a 301 loop");
  assert.equal(noSlash.headers.get("location"),null,"Do not redirect to internal phd-quartz or loop");
  console.log("PASS: /knowledge/PhD resolves without a redirect loop or internal hostname");

  const cases = [
    ["/knowledge/index.html","text/html"],
    ["/knowledge/PhD/index.html","text/html"],
    ["/knowledge/index.css","text/css"],
    ["/knowledge/prescript.js","javascript"],
    ["/knowledge/postscript.js","javascript"],
    ["/knowledge/static/contentIndex.json","json"],
  ];
  for(const [path,expectedType] of cases){
    const res=await fetch(origin+path,{headers,signal:AbortSignal.timeout(10000)});
    assert.equal(res.status,200,`${path}: HTTP ${res.status}`);
    const type=res.headers.get("content-type")||"";
    assert(type.includes(expectedType),`${path}: unexpected content type ${type}`);
    if(expectedType==="json"){
      const data=await res.json();
      assert(data && typeof data==="object","Quartz content index must be JSON");
    }
    console.log(`PASS: ${path} HTTP 200 (${type})`);
  }
  await verifyEmittedAssets("/knowledge/index.html");
  const indexResponse=await fetch(origin+"/knowledge/static/contentIndex.json",{headers,signal:AbortSignal.timeout(10000)});
  assert.equal(indexResponse.status,200,"Quartz content index must load");
  const index=await indexResponse.json();
  const nested=Object.keys(index).find(slug=>slug.includes("/")&&!slug.endsWith("/index")&&!slug.startsWith("tags/"));
  if(nested){
    const nestedPath="/knowledge/"+nested.split("/").map(encodeURIComponent).join("/")+".html";
    await verifyEmittedAssets(nestedPath);
    console.log("PASS: Nested Quartz note uses working asset URLs");
  }else{
    console.log("SKIP: No nested Quartz note in content index");
  }
})().catch(e=>{console.error("FAIL: "+e.message);process.exitCode=1;});
NODE
