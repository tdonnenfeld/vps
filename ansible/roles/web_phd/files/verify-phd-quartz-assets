#!/usr/bin/env bash
set -euo pipefail
cd /opt/phd-hub
container="$(docker compose --env-file .env -f infrastructure/compose.yml -f infrastructure/compose.override.yml ps -q phd-web)"
test -n "$container" || { echo "phd-web is not running" >&2; exit 1; }

# Check the actual Next.js -> nginx/Quartz proxy, without sending private
# documents or application credentials to CI logs.
docker exec -i "$container" node - <<'NODE'
const assert = require("node:assert/strict");
const origin = "http://127.0.0.1:3000";
const headers = {"Remote-User":process.env.ALLOWED_USER || ""};
(async()=>{
  // Docker recreation completes before Next.js is always accepting traffic.
  let ready=false;
  for(let attempt=0;attempt<30;attempt++){
    try{
      const response=await fetch(origin+"/knowledge/index.html",{headers,signal:AbortSignal.timeout(4000)});
      if(response.status===200){ready=true;break;}
    }catch{}
    await new Promise(resolve=>setTimeout(resolve,2000));
  }
  assert(ready,"phd-web/Quartz proxy was not ready after 60 seconds");

  const entry = await fetch(origin+"/knowledge",{headers,redirect:"manual"});
  assert.equal(entry.status,307,"/knowledge must redirect to the folder-aware URL");
  assert.equal(entry.headers.get("location"),"/knowledge/index.html");
  console.log("PASS: Knowledge entry redirects to /knowledge/index.html");

  const vault=await fetch(origin+"/knowledge/PhD/",{headers,redirect:"manual"});
  assert.equal(vault.status,200,"/knowledge/PhD/ must serve the vault folder without stripping its slash");
  assert((vault.headers.get("content-type")??"").includes("text/html"));
  console.log("PASS: /knowledge/PhD/ serves the vault folder without redirects");

  const noSlash=await fetch(origin+"/knowledge/PhD",{headers,redirect:"manual"});
  if(noSlash.status>=300&&noSlash.status<400){
    assert.equal(noSlash.headers.get("location"),"/knowledge/PhD/","Directory redirect must remain relative to public domain");
  }else{assert.equal(noSlash.status,200,"Folder URL must stay on the public host");}
  console.log("PASS: /knowledge/PhD cannot redirect to internal phd-quartz hostname");

  const cases = [
    ["/knowledge/index.html","text/html"],
    ["/knowledge/PhD/index.html","text/html"],
    ["/knowledge/index.css","text/css"],
    ["/knowledge/prescript.js","javascript"],
    ["/knowledge/postscript.js","javascript"],
    ["/knowledge/static/contentIndex.json","json"],
  ];
  for(const [path,expectedType] of cases){
    const res=await fetch(origin+path,{headers,signal:AbortSignal.timeout(10000)});
    assert.equal(res.status,200,`${path}: HTTP ${res.status}`);
    const type=res.headers.get("content-type")||"";
    assert(type.includes(expectedType),`${path}: unexpected content type ${type}`);
    if(expectedType==="json"){
      const data=await res.json();
      assert(data && typeof data==="object","Quartz content index must be JSON");
    }
    console.log(`PASS: ${path} HTTP 200 (${type})`);
  }
})().catch(e=>{console.error("FAIL: "+e.message);process.exitCode=1;});
NODE
