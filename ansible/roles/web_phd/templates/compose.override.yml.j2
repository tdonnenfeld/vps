# PhD Research Hub: only the approved PhD Obsidian vault is mounted read-only.
# MLflow is no longer part of the app; existing artifacts/databases are preserved.
services:
  phd-web:
    environment:
      OBSIDIAN_DAILY_DIR: /mnt/obsidian-phd
    volumes:
      - /opt/services/shared/obsidian/vaults/PhD:/mnt/obsidian-phd:ro
