# PhD Research Hub environment — generated by Ansible, keep private.
DATABASE_URL=postgresql://phd:{{ phd_db_password }}@postgres:5432/phd_hub?schema=public
DEV_AUTH_BYPASS=false
ALLOWED_USER={{ admin_user }}
GITHUB_TOKEN={{ github_token | default('') }}
GITHUB_REPOS={{ phd_github_repos }}
VIKUNJA_URL=http://vikunja:3456
VIKUNJA_TOKEN={{ web_phd_vikunja_token }}

# NOTE: add phd_actions_token to the vault to enable Palma dispatch.
PHD_ACTIONS_TOKEN={{ phd_actions_token | default('') }}
